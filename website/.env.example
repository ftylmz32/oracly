# Optional public production URL for canonical metadata and indexing, e.g. https://oracly.example
# Leave unset for local development; local pages stay noindex.
NEXT_PUBLIC_SITE_URL=

# Coffee V3 web integration stays disabled unless every Firebase/App Check
# value is configured and the explicit live flag is true.
NEXT_PUBLIC_ORACLY_API_BASE_URL=
NEXT_PUBLIC_ORACLY_COFFEE_LIVE_ENABLED=false

# Local test only. Never activates in a production build.
NEXT_PUBLIC_ORACLY_COFFEE_SERVICE=

# Firebase Web App public configuration (Firebase Console > Project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase App Check reCAPTCHA Enterprise site key (public site key, not a secret).
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Server-only persistent order API. Keep disabled until Firebase Admin and a
# reviewed server catalog are configured. Never prefix these with NEXT_PUBLIC_.
ORACLY_ORDERS_ENABLED=false
ORACLY_COFFEE_ORDER_PRICE_MINOR=
ORACLY_COFFEE_CATALOG_VERSION=
FIREBASE_ADMIN_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_APP_CHECK_WEB_APP_ID=

# Prefer Application Default Credentials in managed hosting. These two are an
# optional service-account fallback and must either both be set or both omitted.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
