# ORACLY AI proxy — copy to backend/.env for local development.
# Never commit real secrets. Never put OPENAI_API_KEY in Flutter.

# Required for live AI. Missing → health still works; /v1/ai/complete returns no_configuration.
OPENAI_API_KEY=

# Authoritative model. Client "model" is only a hint if it is in the allowlist.
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_VISION=true

# Server
# Development default is loopback. For Android-device → this PC testing:
#   HOST=0.0.0.0
# Production/staging default is 0.0.0.0. Platforms usually also set PORT.
HOST=127.0.0.1
PORT=8787
# development | staging | production
APP_ENV=development

# Auth: required by default. MockAuth is Flutter debug/test only — not an IdP.
# Production/staging ALWAYS require a real verifier (JWKS or HS256).
# AI_DEV_AUTH_BYPASS is ignored in production/staging.
AI_AUTH_REQUIRED=true
AI_DEV_AUTH_BYPASS=false

# Prefer JWKS from the real identity provider (https in production).
# Android Firebase project (from android/app/google-services.json):
# FIREBASE_PROJECT_ID=oracly-7f613
# That sets:
#   AI_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
#   AI_JWT_ISSUER=https://securetoken.google.com/oracly-7f613
#   AI_JWT_AUDIENCE=oracly-7f613
# Or set those three explicitly:
# AI_JWKS_URL=https://<idp>/.well-known/jwks.json
# AI_JWT_ISSUER=https://<idp>
# AI_JWT_AUDIENCE=oracly-ai

# Alternative: shared HS256 secret (only if the IdP issues HS256).
# AI_JWT_SECRET=

# Rate limit (in-memory, single instance — not distributed)
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=900000
AI_MAX_CONCURRENT=2

# Image / body
AI_MIN_IMAGE_BYTES=8192
AI_MAX_IMAGE_BYTES=12582912
AI_MAX_BODY_BYTES=14680064

# Firebase App Check (required in production/staging; never silently off)
# Client sends header: X-Firebase-AppCheck
# ORACLY_APP_CHECK_REQUIRED / AI_APP_CHECK_REQUIRED force App Check in development.
# ORACLY_APP_CHECK_BYPASS / AI_APP_CHECK_BYPASS is development-only and IGNORED in production/staging.
# FIREBASE_PROJECT_ID=
# FIREBASE_PROJECT_NUMBER=
# AI_APP_CHECK_REQUIRED=false
# AI_APP_CHECK_BYPASS=false

# Process-wide cost safety valves (in-memory — SINGLE INSTANCE only)
# AI_GLOBAL_RPM / ORACLY_GLOBAL_AI_RPM
# AI_GLOBAL_CONCURRENCY / ORACLY_GLOBAL_AI_CONCURRENCY
AI_GLOBAL_RPM=60
AI_GLOBAL_CONCURRENCY=8
AI_EXPENSIVE_RATE_MAX=10
