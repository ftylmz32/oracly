{
  "name": "oracly-ai-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "ORACLY production AI proxy — Flutter → this service → OpenAI",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "build:prod": "tsc -p tsconfig.prod.json",
    "clean": "node -e \"const fs=require('fs');for (const p of ['dist']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch {} }\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "check:openai": "node scripts/check-openai-capabilities.mjs",
    "scan:secrets": "node scripts/scan-deploy-secrets.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@fastify/helmet": "^13.0.1",
    "fastify": "5.12.1",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
