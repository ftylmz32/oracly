<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <!-- Fincan Haritası photos, pins and notes stay on this device. -->
        <exclude domain="root" path="no_backup/coffee_cup_map/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="no_backup/coffee_cup_map/" />
    </device-transfer>
</data-extraction-rules>