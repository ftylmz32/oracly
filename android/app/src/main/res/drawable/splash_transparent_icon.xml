<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ requires a splash icon resource.
  Use solid midnight — NOT transparent. Transparent / empty icons often fall
  back to the adaptive launcher mark (the unwanted first small logo).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <path
        android:fillColor="@color/launch_background"
        android:pathData="M0,0h288v288h-288z" />
</vector>
