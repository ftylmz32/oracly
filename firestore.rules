rules_version = '2';

// ORACLY R7 — Firestore client access is deny-all.
// Sensitive data is read/written only by the ORACLY backend via
// @google-cloud/firestore (service-account credentials), which bypasses
// these Security Rules. Do not grant client SDK access without an
// explicit architecture review.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
