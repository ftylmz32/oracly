# ORACLY AI configuration
# Copy to a local .env for your own notes. Do NOT commit real keys.
# .env is gitignored and is NOT a Flutter asset â€” it never ships in the app.
# Release reads APP_ENV / ORACLY_AI_PROXY_URL from --dart-define only.
# Copy tool/dart_defines.production.example.json â†’ tool/dart_defines.production.json
# then: flutter build apk --release --dart-define-from-file=tool/dart_defines.production.json
# Never commit the real production file (gitignored).

# â”€â”€ Development (Flutter â†’ OpenAI) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local/dev only. NEVER supply this in a production mobile build.
# NEVER pass OPENAI_API_KEY via --dart-define (it would embed the secret).
# OPENAI_API_KEY=

# ORACLY_AI_MODEL=gpt-4o
# ORACLY_AI_TIMEOUT_SECONDS=45
# ORACLY_AI_IMAGE_TIMEOUT_SECONDS=120
# ORACLY_AI_VISION=true

# â”€â”€ Local proxy (Flutter â†’ local backend â†’ OpenAI) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Run backend/ separately. Put OPENAI_API_KEY only in backend/.env.
# APP_ENV=development
# ORACLY_AI_PROXY_URL=http://127.0.0.1:8787/v1/ai/complete

# Android device â†’ developer PC (do not hardcode this IP in source):
# APP_ENV=development
# ORACLY_AI_PROXY_URL=http://<DEVELOPER-PC-LAN-IP>:8787/v1/ai/complete
# Backend must listen on LAN: HOST=0.0.0.0 in backend/.env (explicit only).

# â”€â”€ Production (Flutter â†’ deployed ORACLY proxy â†’ OpenAI) â”€â”€â”€â”€â”€â”€â”€
# Required before store release. The OpenAI secret stays on the server.
# Must NOT contain OPENAI_API_KEY.
# APP_ENV=production
# ORACLY_AI_PROXY_URL=https://<real-production-host>/v1/ai/complete

# Staging example:
# APP_ENV=staging
# ORACLY_AI_PROXY_URL=https://staging-api.oracly.app/v1/ai/complete

# â”€â”€ Auth (Flutter) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Firebase Authentication is the production provider.
# Android: android/app/google-services.json (oracly-7f613 / com.example.oracly_new).
# iOS: ios/Runner/GoogleService-Info.plist (oracly-7f613 / com.example.oraclyNew).
# No invented firebase_options.dart. See docs/AUTH_PRODUCTION.md.

# The backend proxy is Required future production infrastructure.
# See docs/AI_PROXY_CONTRACT.md and docs/AI_PRODUCTION.md.

# â”€â”€ Developer Premium (local QA only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Unlock Premium surfaces (Soul Mate, OR, ...) without store purchase.
# Loaded only when !kReleaseMode via dotenv (.env.example asset).
# Still requires kDebugMode + APP_ENV=development — ignored in profile/release
# and when APP_ENV is production/staging.
# Optional: flutter run --dart-define=ORACLY_DEV_PREMIUM=true
ORACLY_DEV_PREMIUM=true
# To disable local QA: ORACLY_DEV_PREMIUM=false

# â”€â”€ Public legal documents (HTTPS only; never invent placeholder domains) â”€â”€
# Required before store submission when policies are hosted.
# ORACLY_PRIVACY_POLICY_URL=https://<real-public-host>/privacy
# ORACLY_TERMS_OF_USE_URL=https://<real-public-host>/terms

# ORACLY_BILLING_VERIFY_URL=https://<real-production-host>/v1/billing/verify
